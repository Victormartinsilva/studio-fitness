# Copie para .env no desenvolvimento local. Em produção, configure no painel do Render.
DEBUG=True
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria

# Vazio = SQLite local (db.sqlite3). Produção: string de conexão do Neon (com ?sslmode=require).
# Crie o projeto Neon na MESMA região do Render (aws us-east-1 ↔ Render virginia).
# DATABASE_URL=postgresql://usuario:senha@ep-xxxx.us-east-1.aws.neon.tech/studiofitness?sslmode=require

ALLOWED_HOSTS=localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://studiofitness.com.br

# Granularidade das sugestões de horário (min)
AGENDA_PASSO_MINUTOS=5
